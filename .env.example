VITE_SUPABASE_PROJECT_ID="your-dev-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-dev-anon-key"
VITE_SUPABASE_URL="https://your-dev-project.supabase.co"

# Server/local script only. Never expose this with a VITE_ prefix.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-for-import-scripts"

# Supabase Edge Function secret only. Set with:
# supabase secrets set KIOSK_ADMIN_PASSCODE="your-admin-registration-passcode"
KIOSK_ADMIN_PASSCODE="your-admin-registration-passcode"
